# ====== DeepMail 系统级配置（不入仓） ======
# 复制为 .env 后按需修改；不要把真实凭据提交到仓库

# --- 应用基础 ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production

# --- 数据库（PostgreSQL + pgvector）---
# 用户通过 docker-compose 启动本地数据库时使用以下默认
DATABASE_URL=postgresql+asyncpg://deepmail:deepmail@localhost:5432/deepmail

# --- JWT 鉴权 ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- 管理员初始账号（首次初始化时使用）---
# 初始化后请立即修改密码并从 .env 删除此段
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ====== LLM 默认配置（开发阶段使用；用户可在 UI 中覆盖） ======
# 用户登录后可在「个人设置」中配置自己的 API，本节仅作开发兜底
# 提供商: openai / anthropic / minimax / ollama / openai_compatible
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=replace-with-your-real-key
LLM_CHAT_MODEL=MiniMax-M3
LLM_EMBED_MODEL=text-embedding-3-small
LLM_RERANK_MODEL=bge-reranker-base
LLM_EMBED_DIM=1536

# ====== Mock 邮件 ======
MOCK_EMAILS_DIR=./data/mock_emails

# ====== 日志 ======
LOG_LEVEL=INFO
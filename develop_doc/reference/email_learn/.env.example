## ===== QQ 邮箱（推荐，国内首选）=====
#EMAIL_IMAP_HOST=imap.qq.com
#EMAIL_IMAP_PORT=993
#EMAIL_SMTP_HOST=smtp.qq.com
#EMAIL_SMTP_PORT=465
#EMAIL_USER=your_qq_number@qq.com
#EMAIL_PASSWORD=CZ5fQ9XmMaVjpx2W        # ← 不是 QQ 密码！是「授权码」

# ===== 163 邮箱 =====
EMAIL_IMAP_HOST=imap.163.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_USER=ygwstudy@163.com
EMAIL_PASSWORD=CZ5fQ9XmMaVjpx2W        # ← 「授权码」

# ===== Gmail（需要先开两步验证 + App Password）=====
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=your@gmail.com
# EMAIL_PASSWORD=xxxxxxxxxxxxxxxx        # ← 16 位 App Password

# ===== IMAP ID（RFC 2971）=====
# 网易系（163/188）2024 年起强制要求；QQ/Gmail 不强制但加上更稳
# 在 IMAP 握手时告诉服务端「我是谁、什么版本、联系方式」，否则报 Unsafe Login
EMAIL_CLIENT_NAME=email_learn_demo
EMAIL_CLIENT_VERSION=1.0.0
EMAIL_CLIENT_VENDOR=personal_learning
EMAIL_CLIENT_SUPPORT_EMAIL=your_email@example.com